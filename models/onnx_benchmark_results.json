  "deployment_recommendation": {
    "selected_model": "models/cnn_lstm_fp32.onnx",
    "rationale": "ONNX FP32 matches PyTorch FP32 to machine precision (max_abs_diff <= 5.4e-7 in scaled space), achieves the lowest latency on CPU, and occupies only ~0.13 MB. Dynamic QInt8 quantization reduces file size to ~0.034 MB and quantizes Conv, Linear, and LSTM ops, but dynamic activation quantization overhead slows CPU inference on this compact 25,029-parameter network and introduces up to 0.696 scaled / 28.93 mg/m^3 Chla drift."
  }
